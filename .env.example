# ============================================================
# Niche Radar — пример окружения. Скопируйте в .env и заполните.
# Реальный .env создаёт ./bin/setup и НЕ включается в git.
# ============================================================

COMPOSE_PROJECT_NAME=niche-radar

APP_NAME="Niche Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_TIMEZONE=UTC

APP_PORT=127.0.0.1:8080
# Лимит загрузки CSV (байтами; согласован с Nginx и PHP). 5 GiB по умолчанию.
UPLOAD_MAX_BYTES=5368709120

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=niche_radar
DB_USERNAME=niche_radar
DB_PASSWORD=
POSTGRES_PASSWORD=

CACHE_STORE=database
QUEUE_IMPORT_CONNECTION=import
QUEUE_DEFAULT_CONNECTION=default

FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
